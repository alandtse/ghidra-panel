<!DOCTYPE html>
<html lang="en">
<head>
    <title>Admin Dashboard - Ghidra Panel</title>
    {{ template "head.gohtml" . }}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: var(--card-background-color);
            border: 1px solid var(--card-border-color);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            text-align: center;
        }
        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary);
            display: block;
            margin-bottom: 0.5rem;
        }
        .stat-label {
            font-size: 0.9rem;
            color: var(--muted-color);
            display: block;
        }
        .action-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.85rem;
            font-weight: 600;
        }
        .action-login { background: #28a745; color: white; }
        .action-login_failed { background: #dc3545; color: white; }
        .action-account_created { background: #17a2b8; color: white; }
        .action-password_reset { background: #ffc107; color: black; }
        .action-access_requested { background: #6f42c1; color: white; }
        .action-access_granted { background: #20c997; color: white; }
        .action-access_revoked { background: #fd7e14; color: white; }
    </style>
</head>
<body>
{{ template "nav.gohtml" .Data }}
<main class="container">
    <h1>Admin Dashboard</h1>

    <article>
        <header><strong>📊 Panel Statistics</strong></header>
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Stats.TotalUsers }}</span>
                <span class="stat-label">👥 Total Users</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Stats.TotalRepos }}</span>
                <span class="stat-label">🗄️ Repositories</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ formatSize .Data.Stats.TotalDiskUsage }}</span>
                <span class="stat-label">💾 Total Disk Usage</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Stats.ActiveSessions }}</span>
                <span class="stat-label">🔑 Active Sessions (24h)</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Stats.FailedLogins24h }}</span>
                <span class="stat-label">⚠️ Failed Logins (24h)</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Stats.TotalAuditLogs }}</span>
                <span class="stat-label">📝 Audit Log Entries</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ formatUptime .Data.Stats.PanelUptime }}</span>
                <span class="stat-label">⏱️ Panel Uptime</span>
            </div>
        </div>
    </article>

    <article>
        <header>
            <strong>📋 Recent Activity</strong>
        </header>
        <details>
            <summary><strong>ℹ️ About Audit Logs</strong></summary>
            <p>
                Audit logs track all important actions in the panel for security and compliance.
                Old logs are automatically cleaned up daily (configurable retention period).
                Currently showing the {{ len .Data.RecentActivity }} most recent events.
            </p>
        </details>
        {{ if .Data.RecentActivity | len }}
        <figure>
            <table>
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Resource</th>
                        <th>IP Address</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    {{ range $log := .Data.RecentActivity }}
                    <tr>
                        <td><small>{{ formatDate .Timestamp }}</small></td>
                        <td>{{ if .Username }}<samp>{{ .Username }}</samp>{{ else }}<em>System</em>{{ end }}</td>
                        <td><span class="action-badge action-{{ .Action }}" title="{{ .Action }}">{{ actionDesc .Action }}</span></td>
                        <td>
                            {{ if .ResourceName }}
                                <samp>{{ .ResourceName }}</samp>
                                {{ if .ResourceType }}<small>({{ .ResourceType }})</small>{{ end }}
                            {{ else }}
                                -
                            {{ end }}
                        </td>
                        <td><samp>{{ if .IPAddress }}{{ .IPAddress }}{{ else }}-{{ end }}</samp></td>
                        <td><small>{{ formatLocation .Location }}</small></td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
        </figure>
        {{ else }}
        <p>No recent activity.</p>
        {{ end }}
    </article>

    <article>
        <header>
            <strong>👥 User Management</strong>
        </header>
        {{ if .Data.Users | len }}
        <figure>
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Provider</th>
                        <th>Created</th>
                        <th>Repos</th>
                        <th>Last Login</th>
                    </tr>
                </thead>
                <tbody>
                    {{ range $user := .Data.Users }}
                    <tr>
                        <td><samp>{{ .Username }}</samp></td>
                        <td>
                            {{ if .ProfileURL }}
                                <a href="{{ .ProfileURL }}" target="_blank" rel="noopener" title="View {{ .Provider }} profile">
                                    {{ .Provider }} 🔗
                                </a>
                            {{ else }}
                                {{ .Provider }}
                            {{ end }}
                        </td>
                        <td><small>{{ formatDate .CreatedAt }}</small></td>
                        <td>{{ .RepoCount }}</td>
                        <td>
                            {{ if .LastLoginAt }}
                                <small>{{ formatDate .LastLoginAt }}</small>
                            {{ else }}
                                <small><em>Never</em></small>
                            {{ end }}
                        </td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
        </figure>
        {{ else }}
        <p>No users found.</p>
        {{ end }}
    </article>
</main>

{{ template "footer.gohtml" .Data }}
</body>
</html>
