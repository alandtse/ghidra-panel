<!DOCTYPE html>
<html lang="en">
<head>
{{ template "head.gohtml" . }}
<title>Ghidra Credentials</title>
<style>
  .credentials-box {
    background: var(--card-background-color);
    border: 1px solid var(--card-border-color);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }
  .dropdown {
    position: relative;
    display: inline-block;
  }
  .dropdown ul {
    display: none;
    position: absolute;
    background: var(--card-background-color);
    border: 1px solid var(--card-border-color);
    border-radius: var(--border-radius);
    min-width: 200px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    z-index: 1;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }
  .dropdown:hover ul,
  .dropdown:focus-within ul {
    display: block;
  }
  .dropdown ul li {
    margin: 0;
    padding: 0;
  }
  .dropdown ul li a {
    display: block;
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--color);
  }
  .dropdown ul li a:hover {
    background: var(--secondary-hover);
  }
  .credential-field {
    margin-bottom: 1.5rem;
  }
  .credential-field label {
    font-weight: bold;
    display: block;
    margin-bottom: 0.25rem;
  }
  .credential-input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .credential-input-group input {
    width: 100%;
    font-family: monospace;
    font-size: 1.1em;
    margin: 0;
  }
  .credential-input-group button {
    align-self: flex-start;
    margin: 0;
    padding: 0.5rem 1rem;
  }
  .warning-box {
    background: var(--warning-background-color, #fff3cd);
    border: 1px solid var(--warning-border-color, #ffc107);
    border-radius: var(--border-radius);
    padding: 1rem;
    margin-bottom: 1.5rem;
  }
  .success-header {
    color: var(--success-color, #4caf50);
  }
</style>
</head>
<body>
{{ template "nav.gohtml" . }}
<main class="container">
  <article>
    <header>
      {{ if .FirstTime }}
      <h2 class="success-header">✅ Ghidra Account Created!</h2>
      {{ else if .Regenerated }}
      <h2 class="success-header">✅ Password Regenerated</h2>
      {{ else }}
      <h2 class="success-header">✅ Credentials Ready</h2>
      {{ end }}
    </header>

    <div class="warning-box">
      <strong>⚠️ Important:</strong> Save these credentials to your password manager now!
      {{ if .FirstTime }}
      <br>Your username is linked to your <strong>{{ .Identity.Provider }}</strong> account for security.
      <br><br><strong>💡 Forgot your password?</strong> You can generate a new one anytime from the home page using the "Get New Password" button.
      {{ else }}
      <br><br><strong>💡 Note:</strong> This password replaces your previous one. You can generate a new password anytime from the home page.
      {{ end }}
    </div>

    <div class="credentials-box">
      <div class="credential-field">
        <label>Ghidra Server</label>
        <div class="credential-input-group">
          <input type="text" id="server" value="{{ .Ghidra.Hostname }}:{{ .Ghidra.Port }}" readonly>
          <button onclick="copyField('server', this)" class="secondary">
            <i class="fa fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <div class="credential-field">
        <label>Username</label>
        <div class="credential-input-group">
          <input type="text" id="username" value="{{ .Username }}" readonly>
          <button onclick="copyField('username', this)" class="secondary">
            <i class="fa fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <div class="credential-field">
        <label>Password</label>
        <div class="credential-input-group">
          <input type="text" id="password" value="{{ .Password }}" readonly>
          <button onclick="copyField('password', this)" class="secondary">
            <i class="fa fa-copy"></i> Copy
          </button>
        </div>
      </div>
    </div>

    <div class="grid">
      <button onclick="downloadCredentials('txt')" role="button" class="outline">
        <i class="fa fa-download"></i> Download as Text
      </button>
      <div class="dropdown">
        <button role="button" class="outline">
          <i class="fa fa-file-csv"></i> Download for Password Manager ▾
        </button>
        <ul>
          <li><a href="#" onclick="event.preventDefault(); downloadCredentials('1password')">1Password CSV</a></li>
          <li><a href="#" onclick="event.preventDefault(); downloadCredentials('bitwarden')">Bitwarden CSV</a></li>
          <li><a href="#" onclick="event.preventDefault(); downloadCredentials('lastpass')">LastPass CSV</a></li>
          <li><a href="#" onclick="event.preventDefault(); downloadCredentials('keepass')">KeePass CSV</a></li>
          <li><a href="#" onclick="event.preventDefault(); downloadCredentials('generic')">Generic CSV</a></li>
        </ul>
      </div>
      <a href="/" role="button" class="contrast">
        Continue to Panel →
      </a>
    </div>

    {{ if .FirstTime }}
    <small>
      <strong>Next steps:</strong>
      <ol>
        <li>Open Ghidra on your computer</li>
        <li>Go to <em>File → New Project → Shared Project</em></li>
        <li>Enter the server address, username, and password above</li>
        <li>Request access to repositories from the panel</li>
      </ol>
    </small>
    {{ end }}
  </article>
</main>

<script>
function copyField(fieldId, buttonElement) {
  const field = document.getElementById(fieldId);
  field.select();
  field.setSelectionRange(0, 99999); // For mobile
  
  navigator.clipboard.writeText(field.value).then(() => {
    // Visual feedback
    const originalHTML = buttonElement.innerHTML;
    buttonElement.innerHTML = '<i class="fa fa-check"></i> Copied!';
    setTimeout(() => {
      buttonElement.innerHTML = originalHTML;
    }, 2000);
  }).catch(err => {
    alert('Failed to copy: ' + err);
  });
}

// Password Manager CSV Export Formats
// These formats are hard-coded based on official documentation from each password manager.
// Last verified: 2024-12
//
// Sources:
// - 1Password: https://support.1password.com/import-csv/
// - Bitwarden: https://bitwarden.com/help/import-data/
// - LastPass: https://support.lastpass.com/help/how-do-i-import-stored-data-into-lastpass
// - KeePass: https://keepass.info/help/base/import.html
// - Generic: Common format compatible with most managers
//
// Note: If a password manager updates their import format, update the corresponding
// section below and the "Last verified" date above.
function downloadCredentials(format) {
  const server = document.getElementById('server').value;
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;
  const timestamp = new Date().toISOString();
  const communityName = '{{ .CommunityName }}' || 'Ghidra Server';
  const title = communityName;
  
  let content, filename;
  
  if (format === '1password') {
    // 1Password CSV format (verified 2024-12)
    content = `title,website,username,password,notes
${title},ghidra://${server},${username},${password},Generated: ${timestamp}`;
    filename = `ghidra-1password-${username}.csv`;
  } else if (format === 'bitwarden') {
    // Bitwarden CSV format
    content = `folder,favorite,type,name,notes,fields,reprompt,login_uri,login_username,login_password,login_totp
,,,${title},Generated: ${timestamp},,0,ghidra://${server},${username},${password},`;
    filename = `ghidra-bitwarden-${username}.csv`;
  } else if (format === 'lastpass') {
    // LastPass CSV format
    content = `url,username,password,extra,name,grouping,fav
ghidra://${server},${username},${password},Generated: ${timestamp},${title},,0`;
    filename = `ghidra-lastpass-${username}.csv`;
  } else if (format === 'keepass') {
    // KeePass CSV format
    content = `"Account","Login Name","Password","Web Site","Comments"
"${title}","${username}","${password}","ghidra://${server}","Generated: ${timestamp}"`;
    filename = `ghidra-keepass-${username}.csv`;
  } else if (format === 'generic') {
    // Generic CSV format (works with many password managers)
    content = `name,url,username,password,notes
${title},ghidra://${server},${username},${password},Generated: ${timestamp}`;
    filename = `ghidra-generic-${username}.csv`;
  } else {
    // Plain text format
    content = `${title} - Ghidra Credentials
${'='.repeat(title.length + 22)}

Server:   ${server}
Username: ${username}
Password: ${password}

Generated: ${timestamp}

⚠️  Keep these credentials secure!
⚠️  Do not share your password with anyone.

To import into password manager:
1. Use the "Download for Password Manager" dropdown and select your password manager
2. Import the downloaded CSV file
3. Or manually create a new entry with the above details
`;
    filename = `ghidra-credentials-${username}.txt`;
  }
  
  const mimeType = format === 'txt' ? 'text/plain' : 'text/csv';
  const blob = new Blob([content], { type: mimeType });
  const url = window.URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  window.URL.revokeObjectURL(url);
  document.body.removeChild(a);
}
</script>

{{ template "footer.gohtml" . }}
</body>
</html>
