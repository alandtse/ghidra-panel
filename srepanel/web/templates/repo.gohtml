<!DOCTYPE html>
<html lang="en">
<head>
    <title>Ghidra Panel - {{ .Data.Repo.Name }}</title>
    {{ template "head.gohtml" . }}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: var(--card-background-color);
            border: 1px solid var(--card-border-color);
            border-radius: var(--border-radius);
            padding: 1rem;
            text-align: center;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary);
            display: block;
        }
        .stat-label {
            font-size: 0.9rem;
            color: var(--muted-color);
            margin-top: 0.25rem;
            display: block;
        }
    </style>
</head>
<body>
{{ template "nav.gohtml" .Data }}
<main class="container">
    <h1>{{ .Data.Repo.Name }}</h1>
    {{ template "status.gohtml" .Data }}
    
    {{ if .Data.Repo.Stats }}
    <article>
        <header><strong>Repository Stats</strong></header>
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Repo.Stats.UserCount }}</span>
                <span class="stat-label">👥 Users</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ .Data.Repo.Stats.FileCount }}</span>
                <span class="stat-label">📁 Files</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ formatDate .Data.Repo.Stats.LastModifiedTime }}</span>
                <span class="stat-label">📅 Last Modified</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ formatSize .Data.Repo.Stats.SizeBytes }}</span>
                <span class="stat-label">💾 Size</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{{ formatDate .Data.Repo.Stats.CreatedTime }}</span>
                <span class="stat-label">🎂 Created</span>
            </div>
        </div>
    </article>
    {{ end }}
    
    <div class="grid">
        <article>
            <header>
                <strong>Users</strong>
            </header>
            {{ if .Data.ACL | len  }}
            <ul class="list">
            {{ range $acl := .Data.ACL }}
            <li>
                <samp>{{ .User }}</samp>
                <span style="color: {{ permColor .Perm }}">{{ permDisplay .Perm }}</span>
                <form action="/set_user_access" method="post">
                    {{$.CSRFField}}
                    <input type="hidden" name="repo" value="{{ $.Data.Repo.Name }}">
                    <input type="hidden" name="user" value="{{ .User }}">
                    <input type="hidden" name="role" value="NONE">
                    <button class="small outline secondary"><i class="fa-solid fa-xmark"></i></button>
                </form>
            </li>
            {{ end }}
            </ul>
            {{ else }}
            <p>No users added to repository.</p>
            {{ end }}
        </article>
        <div>
        <article>
            <header>
                <strong>Add User</strong>
            </header>
            <form action="/set_user_access" method="post">
                {{.CSRFField}}
                <input type="hidden" name="repo" value="{{ .Data.Repo.Name }}">
                <label for="user">Users</label>
                <select id="user" name="user" required>
                    <option value="" disabled selected>Select a user...</option>
                    {{ range $users := .Data.Users }}
                        {{ if eq $users $.Data.QueryUser }}
                            <option value="{{ $users }}" selected>{{ $users }}</option>
                        {{ else }}
                            <option value="{{ $users }}">{{ $users }}</option>
                        {{ end }}
                    {{ end }}
                </select>
                <label for="role">Role</label>
                <div class="password_row">
                    <select id="role" name="role" required>
                        <option value="" disabled selected>Select a role...</option>
                        {{ if eq .Data.QueryRole "READ_ONLY" }}
                            <option value="READ_ONLY" selected>Read</option>
                        {{ else }}
                            <option value="READ_ONLY">Read</option>
                        {{ end }}
                        {{ if eq .Data.QueryRole "WRITE" }}
                            <option value="WRITE" selected>Write</option>
                        {{ else }}
                            <option value="WRITE">Write</option>
                        {{ end }}
                        {{ if eq .Data.QueryRole "ADMIN" }}
                            <option value="ADMIN" selected>Admin</option>
                        {{ else }}
                            <option value="ADMIN">Admin</option>
                        {{ end }}
                    </select>
                    <button role="button" type="submit" class="outline">Add</button>
                </div>
            </form>
        </article>
        <article>
            <header>
                <strong>Settings</strong>
            </header>
            <form action="/update_repo" method="post">
                {{.CSRFField}}
                <input type="hidden" name="repo" value="{{ .Data.Repo.Name }}">
                <label for="webhook_url">Discord Webhook URL</label>
                {{ if .Data.Repo.WebhookURL }}
                <input type="text" id="webhook_url" name="webhook_url" placeholder="Type DELETE to remove">
                {{ else }}
                <input type="text" id="webhook_url" name="webhook_url" placeholder="Not configured">
                {{ end }}
                <button role="button" type="submit" class="outline">Update</button>
            </form>
        </article>
        {{ if .CanDelete }}
        <article>
            <header>
                <strong>Delete Repository</strong>
            </header>
            <form action="/delete_repo" method="post">
                {{.CSRFField}}
                <input type="hidden" name="repo" value="{{ .Data.Repo.Name }}">
                <label for="confirm">Confirm</label>
                <input type="text" id="confirm" name="confirm" placeholder="Enter repository name to confirm">
                <button role="button" type="submit" class="outline">Delete</button>
            </form>
        </article>
        {{ end }}
        </div>
    </div>
</main>
{{ template "footer.gohtml" .Data }}
</body>
</html>
