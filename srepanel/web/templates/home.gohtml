<!DOCTYPE html>
<html lang="en">
<head>
  <title>Ghidra Panel - Home</title>
  {{ template "head.gohtml" . }}
  <style>
    .role-checkboxes {
      display: inline-flex;
      gap: 1rem;
      align-items: center;
      margin-left: 1rem;
      font-size: 0.9em;
    }
    .role-checkboxes label {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
      cursor: default;
    }
    .role-checkboxes input[type="checkbox"] {
      margin: 0;
      cursor: default;
      pointer-events: none;
    }
    .admin-toggle {
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
{{ template "nav.gohtml" .Data }}
<main class="container">
  <h1>Hi, {{ .Data.Identity.Username }}!</h1>
  {{ template "status.gohtml" .Data }}
  
  {{ if and .Data.SuperAdmin (not .Data.AdminModeDisabled) }}
  <article style="border-left: 4px solid {{ permColor 2 }}; background: rgba(76, 175, 80, 0.05);">
    <header>
      <strong>🔑 Panel Super Admin</strong>
    </header>
    <p>You have super admin privileges and can manage all repositories and users.</p>
    {{ if .Data.GhidraOnline }}
    <p><small>✓ Ghidra server is online — You can manage all repositories below</small></p>
    {{ else }}
    <p><small>⚠ Ghidra server is offline — Repository management will be available when the server is online</small></p>
    {{ end }}
  </article>
  {{ end }}
  
  {{ if and .Data.SuperAdmin (not .Data.AdminModeDisabled) }}
  <article>
    <header>
      <strong>Repository Access</strong>
      <small style="color: {{ permColor 2 }}">(Admin access to all repos)</small>
    </header>
    {{ if .Data.ACL | len  }}
    <figure>
      <table>
        <thead>
          <tr>
            <th>Repository</th>
            <th>Access</th>
            <th>👥 Users</th>
            <th>📁 Files</th>
            <th>💾 Size</th>
            <th>📅 Updated</th>
          </tr>
        </thead>
        <tbody>
          {{ range $acl := .Data.ACL }}
          <tr>
            <td>
              {{ if .IsAdmin }}
              <a href="/repos/{{ .Repo }}"><samp>{{ .Repo }}</samp></a>
              {{ else }}
              <samp>{{ .Repo }}</samp>
              {{ end }}
            </td>
            <td>
              <div class="role-checkboxes">
                <label title="Read-Only"><input type="checkbox" {{ if or (eq .Perm 0) (eq .Perm 1) (eq .Perm 2) }}checked{{ end }} disabled>R</label>
                <label title="Read/Write"><input type="checkbox" {{ if or (eq .Perm 1) (eq .Perm 2) }}checked{{ end }} disabled>W</label>
                <label title="Admin"><input type="checkbox" {{ if eq .Perm 2 }}checked{{ end }} disabled>A</label>
              </div>
            </td>
            <td>{{ if .Stats }}{{ .Stats.UserCount }}{{ else }}-{{ end }}</td>
            <td>{{ if .Stats }}{{ .Stats.FileCount }}{{ else }}-{{ end }}</td>
            <td>{{ if .Stats }}{{ formatSize .Stats.SizeBytes }}{{ else }}-{{ end }}</td>
            <td>{{ if .Stats }}{{ formatDate .Stats.LastModifiedTime }}{{ else }}-{{ end }}</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </figure>
    {{ else }}
    <p>Your account doesn't have access to any repositories yet.</p>
    {{ end }}
  </article>
  {{ end }}

  {{ if or (not .Data.SuperAdmin) .Data.AdminModeDisabled }}
  <div class="grid">
  <article>
    <header>
      <strong>Repository Access</strong>
    </header>
    {{ if .Data.ACL | len  }}
    <ul class="list">
      {{ range $repo := .Data.ACL }}
      <li>
        {{ if .IsAdmin }}
        <a href="/repos/{{ .Repo }}"><samp>{{ .Repo }}</samp></a>
        {{ else }}
        <samp>{{ .Repo }}</samp>
        {{ end }}
        <div class="role-checkboxes">
          <label title="Read-Only Access">
            <input type="checkbox" {{ if or (eq .Perm 0) (eq .Perm 1) (eq .Perm 2) }}checked{{ end }} disabled>
            Read
          </label>
          <label title="Read/Write Access">
            <input type="checkbox" {{ if or (eq .Perm 1) (eq .Perm 2) }}checked{{ end }} disabled>
            Write
          </label>
          <label title="Admin Access">
            <input type="checkbox" {{ if eq .Perm 2 }}checked{{ end }} disabled>
            Admin
          </label>
        </div>
      </li>
      {{ end }}
    </ul>
    {{ else }}
    <p>Your account doesn't have access to any repositories yet.</p>
    {{ end }}
  </article>
  
  <article>
    {{ if .Data.UserState.HasPassword }}
    <header>
      <strong>Request Access</strong>
    </header>
    <form action="/request_access" method="post">
      {{.CSRFField}}
      <label for="repo">Repository</label>
      <select id="repo" name="repo" required>
        <option value="" disabled selected>Select a repository...</option>
        {{ range $repo := .Data.Repos }}
        <option value="{{ $repo }}">{{ $repo }}</option>
        {{ end }}
      </select>
      <label for="role">Role</label>
      <div class="password_row">
        <select id="role" name="role" required>
          <option value="" disabled selected>Select a role...</option>
          <option value="READ_ONLY">Read</option>
          <option value="WRITE">Write</option>
          <option value="ADMIN">Admin</option>
        </select>
        <button role="button" type="submit" class="outline">Request</button>
      </div>
    </form>
    {{ else }}
    <header>
      <strong>Request Access</strong>
    </header>
    <p>You need to create a Ghidra account before you can request access to repositories.</p>
    {{ end }}
  </article>
  </div>
  {{ end }}

  <div class="grid">
    {{ if and .Data.UserState .Data.UserState.HasPassword }}
    <article>
      <header>
        <strong>Connection Information</strong>
      </header>
      <div class="grid">
        <label>
          Hostname
          <input type="text" value="{{ .Data.Ghidra.Hostname }}" readonly>
        </label>
        <label>
          Port
          <input type="text" value="{{ .Data.Ghidra.Port }}" readonly>
        </label>
      </div>
      <small>Server version: {{ .Data.GhidraVersion }}</small>

      <label>Username</label>
      <input type="text" value="{{ .Data.UserState.Username }}" readonly>
      <small>
        <i class="fa fa-lock"></i> Your username is linked to your <strong>{{ .Data.Identity.Provider }}</strong> account and cannot be changed.
      </small>

      <hr>
      <header>
        <strong>Client Setup</strong>
      </header>
      <p><small>To connect your local Ghidra client to this server, you must ensure your client username matches your panel username (<samp>{{ .Data.UserState.Username }}</samp>).</small></p>
      <ol style="font-size: 0.9em; padding-left: 1.5rem;">
        <li>Locate your local Ghidra installation directory.</li>
        <li>Open <samp>support/launch.properties</samp> in a text editor.</li>
        <li>Add the following line (usually near the top):<br>
          <code style="display: block; margin-top: 0.5rem; padding: 0.5rem; background: var(--pico-code-background-color); border-radius: var(--pico-border-radius);">VMARGS=-Duser.name={{ .Data.UserState.Username }}</code>
        </li>
        <li>Restart your Ghidra client.</li>
      </ol>
      <small><i class="fa fa-info-circle"></i> If you skip this step, Ghidra will attempt to log in using your computer's local account name, which will result in an "Access Denied" error.</small>
    </article>

    <article>
      <header>
        <strong>Password Management</strong>
      </header>
      <form action="/update_account" method="post">
        {{.CSRFField}}
        <label>Password</label>
        <button role="button" type="submit" class="outline">
          <i class="fa fa-sync-alt"></i> Get New Password
        </button>
        <small>
          <i class="fa fa-info-circle"></i> Click to generate a new password anytime you need to see it (e.g., to login to Ghidra).
          <br><strong>Tip:</strong> Save the password to your password manager after generating.
        </small>
      </form>
    </article>

    <article>
      <header>
        <strong>Linked Accounts</strong>
      </header>
      <p><small>Log in with any linked account to access this Ghidra identity.</small></p>
      <ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
        <li style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; padding: 0.5rem; background: var(--pico-background-color); border: 1px solid var(--pico-muted-border-color); border-radius: var(--pico-border-radius);">
          <div>
            <strong>{{ .Data.Identity.Provider }}</strong> <small>(Primary)</small>
            <br><small>{{ .Data.Identity.Username }}</small>
          </div>
        </li>
        {{ range .Data.LinkedAccounts }}
        <li style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; padding: 0.5rem; background: var(--pico-background-color); border: 1px solid var(--pico-muted-border-color); border-radius: var(--pico-border-radius);">
          <div>
            <strong>{{ .Provider }}</strong>
            <br><small>{{ .Username }}</small>
          </div>
          <form action="/unlink_account" method="post" style="margin: 0;">
            {{ $.CSRFField }}
            <input type="hidden" name="provider" value="{{ .Provider }}">
            <input type="hidden" name="id" value="{{ .ID }}">
            <button class="outline contrast" type="submit" style="margin: 0; padding: 0.25rem 0.5rem; font-size: 0.8em; border: none;" title="Unlink Account" onclick="return confirm('Unlink this account? You will no longer be able to log in with it.')">
              <i class="fa fa-unlink"></i> Unlink
            </button>
          </form>
        </li>
        {{ end }}
      </ul>
      {{ if .Data.AvailableProviders }}
      <div style="margin-top: 1rem; border-top: 1px solid var(--pico-muted-border-color); padding-top: 1rem;">
        <strong>Link New Account</strong>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem;">
          {{ range .Data.AvailableProviders }}
          <a role="button" class="outline" href="/oauth/{{ .Name }}?link=true" style="padding: 0.5rem 1rem;">
            <i class="fa fa-link"></i> {{ .DisplayName }}
          </a>
          {{ end }}
        </div>
      </div>
      {{ end }}
    </article>
    {{ else }}
    <article>
      <header>
        <strong>Welcome!</strong>
      </header>
      <p>Create your Ghidra account to start collaborating. A secure username and passphrase will be automatically generated for you.</p>
      <form action="/create_account" method="post">
        {{.CSRFField}}
        <button role="button" type="submit">
          <i class="fa fa-user-plus"></i> Create Ghidra Account
        </button>
      </form>
      <small>
        <i class="fa fa-shield-alt"></i> Your account will be securely linked to your <strong>{{ .Data.Identity.Provider }}</strong> profile for accountability.
      </small>
    </article>
    {{ end }}
  </div>

  {{ if and .Data.UserState .Data.UserState.HasPassword }}
  <article style="border: 1px solid var(--pico-del-color); margin-top: var(--pico-spacing);">
    <header style="background-color: rgba(216, 27, 96, 0.05); color: var(--pico-del-color);">
      <strong>Danger Zone</strong>
    </header>
    <p>Permanently delete your Ghidra account, your repository access, and all associated OAuth login identities. This action cannot be undone.</p>
    <form action="/delete_account" method="post" style="margin-bottom: 0;">
      {{.CSRFField}}
      <button role="button" type="submit" class="outline contrast" style="color: var(--pico-del-color); border-color: var(--pico-del-color);" onclick="return prompt('Are you absolutely sure you want to delete your account? Type DELETE to confirm.') === 'DELETE'">
        <i class="fa fa-trash-alt"></i> Delete Account
      </button>
    </form>
  </article>
  {{ end }}
</main>



{{ template "footer.gohtml" .Data }}
</body>
</html>
